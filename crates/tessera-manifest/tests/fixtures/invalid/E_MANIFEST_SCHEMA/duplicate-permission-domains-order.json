{
  "manifest": {
    "manifestVersion": 1,
    "id": "com.example.myplugin",
    "name": "My Plugin",
    "version": "1.2.0",
    "engines": { "core": 1, "pluginApi": "^0.2.0" },
    "main": "plugin.wasm",
    "activationEvents": ["onCommand:run"],
    "permissions": [
      { "type": "net.http", "allowedDomains": ["a.com", "b.com"] },
      { "type": "net.http", "allowedDomains": ["b.com", "a.com"] }
    ],
    "contributes": {
      "commands": [{ "id": "run", "title": "运行" }]
    }
  }
}
